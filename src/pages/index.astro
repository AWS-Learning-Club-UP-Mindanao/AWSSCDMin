---
import BaseLayout from "../layouts/BaseLayout.astro";
import Schedule from "../components/sections/Schedule.astro";
import Hero from "../components/sections/Hero.astro";
import Header from "../components/Header.astro";
import Location from "../components/sections/Location.astro";
import About from "../components/sections/About.astro";
import TicketTiers from "../components/sections/TicketTiers.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/sections/FAQ.astro";
import { heroLogo, heroLogoSizes } from "../assets/logos/hero-logo";
---

<BaseLayout
  title="AWS Student Community Day Mindanao 2026"
  description="AWS Student Community Day Mindanao 2026. A one-day student conference on cloud, AI, and building in community."
>
  <!-- The hero logo is the largest thing on first paint, but its <img> sits behind ~75 KB of inlined CSS.
       Preloading it here starts the download as soon as the <head> arrives. -->
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLogo.src}
    imagesrcset={heroLogo.srcSet.attribute}
    imagesizes={heroLogoSizes}
    fetchpriority="high"
  />
  <Header slot="header" />

  <!-- Ticket 07 -->
  <Hero />

  <!-- Ticket 08 -->
  <About />

  <TicketTiers />

	<!-- Ticket 09 -->
	<Schedule />

	<!-- Ticket 12 -->
	<Location />

	<!-- Ticket 13 -->
	<FAQ />

	<!-- Ticket 06  -->
	<Footer slot="footer" />
</BaseLayout>

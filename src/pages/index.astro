---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Schedule from "../components/sections/Schedule.astro";
import Hero from "../components/sections/Hero.astro";
import Header from "../components/Header.astro";
import Location from "../components/sections/Location.astro";
import TicketTiers from "../components/sections/TicketTiers.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/sections/FAQ.astro";
---

<BaseLayout
  title="AWS Student Community Day Mindanao"
  description="AWS Student Community Day Mindanao. A one-day student conference on cloud, AI, and building in community."
>
  <Header slot="header" />

  <!-- Ticket 07 -->
  <Hero />

  <Section id="about">
    <p class="text-caption text-content-secondary">About (Ticket 08)</p>
  </Section>
  <TicketTiers />
	<Schedule />

	<!-- Ticket 10 -->
	<Section id="tickets">
		<p class="text-caption text-content-secondary">Ticket tiers (Ticket 10)</p>
	</Section>

	<!-- Ticket 11 -->
	<Section id="speakers">
		<p class="text-caption text-content-secondary">Speakers (Ticket 11)</p>
	</Section>

	<!-- Ticket 12 -->
	<Location />

	<!-- Ticket 13 -->
	<FAQ />

	<!-- Ticket 06: the closing CTA and footer. Lives in the layout's footer slot. -->
	<Footer slot="footer" />
</BaseLayout>

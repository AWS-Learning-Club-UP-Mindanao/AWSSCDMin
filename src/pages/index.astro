---
import BaseLayout from "../layouts/BaseLayout.astro";
import Schedule from "../components/sections/Schedule.astro";
import Hero from "../components/sections/Hero.astro";
import Header from "../components/Header.astro";
import Location from "../components/sections/Location.astro";
import TicketTiers from "../components/sections/TicketTiers.astro";
import Speakers from "../components/sections/Speakers.astro";
import About from "../components/sections/About.astro";
import Footer from "../components/Footer.astro";
import FAQ from "../components/sections/FAQ.astro";
import { heroLogo, heroLogoSizes } from "../assets/logos/hero-logo";
---

<BaseLayout
  title="AWS Student Community Day Mindanao 2026"
  description="AWS Student Community Day Mindanao 2026. A one-day student conference on cloud, AI, and building in community."
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLogo.src}
    imagesrcset={heroLogo.srcSet.attribute}
    imagesizes={heroLogoSizes}
    fetchpriority="high"
  />
  <Header slot="header" />
  <Hero />
  <About />
  <TicketTiers />
	<Schedule />
  <Speakers />
	<Location />
	<FAQ />
	<Footer slot="footer" />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Schedule from "../components/sections/Schedule.astro";
import Header from "../components/Header.astro";
import Location from "../components/sections/Location.astro";
import TicketTiers from "../components/sections/TicketTiers.astro";
import Speakers from "../components/sections/Speakers.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="AWS Student Community Day Mindanao"
  description="AWS Student Community Day Mindanao. A one-day student conference on cloud, AI, and building in community."
>
  <Header slot="header" />

  <Section id="hero">
    <p class="text-caption text-content-secondary">Hero (Ticket 07)</p>
  </Section>

  <Section id="about">
    <p class="text-caption text-content-secondary">About (Ticket 08)</p>
  </Section>

  <TicketTiers />
	<Schedule />
  <Speakers />
  <Location />

  <Section id="faq">
    <p class="text-caption text-content-secondary">FAQ (Ticket 13)</p>
  </Section>
  
  <Footer slot="footer" />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
	title="AWS Student Community Day Mindanao"
	description="AWS Student Community Day Mindanao. A one-day student conference on cloud, AI, and building in community."
>
	<!--
		Section order as agreed in Ticket 03. Each one is a placeholder for now: the content,
		styling and assets land in the section tickets. The ids are the anchors the header nav
		and the footer CTA will link to, so keep them stable.
	-->

	<!-- Ticket 07 -->
	<Section id="hero">
		<p class="text-caption text-content-secondary">Hero (Ticket 07)</p>
	</Section>

	<!-- Ticket 08 -->
	<Section id="about">
		<p class="text-caption text-content-secondary">About (Ticket 08)</p>
	</Section>

	<!-- Ticket 09 -->
	<Section id="schedule">
		<p class="text-caption text-content-secondary">Schedule (Ticket 09)</p>
	</Section>

	<!-- Ticket 10 -->
	<Section id="tickets">
		<p class="text-caption text-content-secondary">Ticket tiers (Ticket 10)</p>
	</Section>

	<!-- Ticket 11 -->
	<Section id="speakers">
		<p class="text-caption text-content-secondary">Speakers (Ticket 11)</p>
	</Section>

	<!-- Ticket 12 -->
	<Section id="location">
		<p class="text-caption text-content-secondary">Location (Ticket 12)</p>
	</Section>

	<!-- Ticket 13 -->
	<Section id="faq">
		<p class="text-caption text-content-secondary">FAQ (Ticket 13)</p>
	</Section>

	<!-- Ticket 06: the closing CTA and footer. Lives in the layout's footer slot. -->
	<Footer slot="footer" />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/Button.astro";
---

<BaseLayout title="Page not found">
  <main id="main">
    <Section
      spacing="none"
      class="flex min-h-[100dvh] items-center justify-center py-24"
      backgroundImage="/assets/backgrounds/star_background.svg"
    >
      <div class="mx-auto flex max-w-[46rem] flex-col items-center gap-4 text-center">
        <p class="font-display text-[clamp(4.5rem,14vw,10rem)] leading-none tracking-[0.06em] text-content-primary">
          404
        </p>

        <h1 class="font-display text-[clamp(2rem,5vw,3.5rem)] leading-[1.05] text-content-primary">
          Oops...
        </h1>

        <h2 class="font-body text-h4 text-content-primary md:text-h3">How did you get here?</h2>

        <p class="max-w-[34rem] text-body text-content-secondary text-pretty">
          The link you followed doesn't lead anywhere. It may have been mistyped, or the page it
          pointed to no longer exists.
        </p>

        <Button href="/" label="Back to the event page" variant="cta" size="lg" class="mt-4" />
      </div>
    </Section>
  </main>
</BaseLayout>

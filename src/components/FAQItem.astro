---
interface Props {
	question: string;
	answer: string;
}

const { question, answer } = Astro.props;
---

<details class="faq-item overflow-hidden rounded-lg bg-surface-brand">
	<summary
		class="flex cursor-pointer list-none items-center justify-between gap-6 py-3.5 pl-8 pr-4 text-body text-content-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface-accent [&::-webkit-details-marker]:hidden"
	>
		<span class="text-pretty">{question}</span>
		<svg
			class="faq-chevron shrink-0 text-surface-accent"
			width="12"
			height="7"
			viewBox="0 0 12 7"
			fill="none"
			aria-hidden="true"
		>
			<path
				d="M1 1l5 5 5-5"
				stroke="currentColor"
				stroke-width="1.5"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</summary>

	<div class="faq-answer">
		<p class="px-8 pb-5 text-body text-content-secondary text-pretty">{answer}</p>
	</div>
</details>

<style>
	.faq-item {
		--faq-open: 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
		--faq-close: 360ms cubic-bezier(0.36, -0.55, 0.6, 1);
	}

	.faq-answer {
		overflow: hidden;
	}

	/* Chromium opens and closes the box itself. No other engine can interpolate to an
	   intrinsic height yet, so there the script in FAQ.astro does the same two moves. */
	@supports (interpolate-size: allow-keywords) and selector(::details-content) {
		.faq-item {
			interpolate-size: allow-keywords;
		}

		.faq-item::details-content {
			block-size: 0;
			overflow: hidden;
			transition:
				block-size var(--faq-close),
				content-visibility var(--faq-close) allow-discrete;
		}

		.faq-item[open]::details-content {
			block-size: auto;
			transition:
				block-size var(--faq-open),
				content-visibility var(--faq-open) allow-discrete;
		}
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-chevron {
		transition: transform var(--faq-open);
	}

	.faq-item[open] .faq-chevron {
		transform: rotate(180deg);
	}

	.faq-item[open] .faq-answer p {
		animation: faq-answer-in var(--faq-open);
	}

	@keyframes faq-answer-in {
		from {
			opacity: 0;
		}

		to {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-item::details-content,
		.faq-chevron {
			transition: none;
		}

		.faq-item[open] .faq-answer p {
			animation: none;
		}
	}
</style>

---
import Container from './Container.astro';

interface Props {
	/** Anchor id, so the header nav and the footer CTA can link straight to this section. */
	id?: string;
	/** Vertical rhythm. Pick from this scale instead of adding padding per section. */
	spacing?: 'none' | 'sm' | 'md' | 'lg' | 'hero';
	/** Full-bleed artwork behind the content. Clipped to the section. */
	backgroundImage?: string;
	/** Let the children run past the content column, page gutters still applied. */
	fullWidth?: boolean;
	class?: string;
}

const {
	id,
	spacing = 'md',
	backgroundImage,
	fullWidth = false,
	class: className = '',
} = Astro.props;

const spacingClass = {
	none: '',
	sm: 'py-12 md:py-16 lg:py-20',
	md: 'py-16 md:py-24 lg:py-32',
	lg: 'py-24 md:py-32 lg:py-40',
	// Vertical padding that clears the fixed header and grows as the screen shrinks (~104px at 1440px+,
	// ~166px at 393px). Exposed as --hero-pad so the hero can size its content box to fill the viewport.
	hero: '[--hero-pad:clamp(104px,calc(190px_-_6.2vw),32px)] py-(--hero-pad)',
}[spacing];
---

<!--
	overflow-x-clip is the guard against decorative artwork widening the page. Anything that
	hangs off the side of a section gets cut horizontally, with no scrollbar and without
	clipping vertically, so a nebula can still bleed into the section below it.
-->
<section id={id} class:list={['relative isolate overflow-x-clip', spacingClass, className]}>
	{
		backgroundImage && (
			<img
				src={backgroundImage}
				alt=""
				decoding="async"
				class="pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover"
			/>
		)
	}

	<!--
		Decorative stars and nebulae belong in the decorations slot. They are positioned
		absolutely inside this layer, so they never push layout around or add page width.
	-->
	<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
		<slot name="decorations" />
	</div>

	<Container wide={fullWidth}>
		<slot />
	</Container>
</section>

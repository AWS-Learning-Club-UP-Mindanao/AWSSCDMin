---
import Button from "./Button.astro";

interface Props {
  ticketUrl?: string;
}

const { ticketUrl = "https://example.com/tickets" } = Astro.props;

const links = [
  { label: "About", href: "/#about" },
  { label: "Schedule", href: "/#schedule" },
  { label: "Speakers", href: "/#speakers" },
  { label: "Sponsors", href: "/#sponsors" },
  { label: "FAQ", href: "/#faq" },
];
---
<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const button =
    header?.querySelector<HTMLButtonElement>("[data-menu-button]");
  const drawer =
    header?.querySelector<HTMLElement>("[data-mobile-drawer]");
  const homeLink =
    header?.querySelector<HTMLAnchorElement>("[data-home-link]");

  if (header && button && drawer && homeLink) {
    const mobile = window.matchMedia("(max-width: 767px)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let drawerAnimation: Animation | null = null;

    const setOpen = (open: boolean, restoreFocus = false) => {
      const expanded = open && mobile.matches;
      const wasHidden = drawer.hidden;
      const currentStyle = getComputedStyle(drawer);
      const opacity = wasHidden ? "0" : currentStyle.opacity;
      const transform = reducedMotion.matches
        ? "none"
        : wasHidden ? "translateY(-12px)" : currentStyle.transform;

      drawerAnimation?.cancel();
      drawerAnimation = null;

      button.setAttribute("aria-expanded", String(expanded));
      button.setAttribute(
        "aria-label",
        expanded ? "Close navigation menu" : "Open navigation menu",
      );

      drawer.inert = !expanded;
      drawer.setAttribute("aria-hidden", String(!expanded));

      if (!mobile.matches || (!expanded && wasHidden)) {
        drawer.hidden = !expanded;
      } else {
        drawer.hidden = false;
        const animation = drawer.animate(
          [
            { opacity, transform },
            {
              opacity: expanded ? "1" : "0",
              transform: reducedMotion.matches
                ? "none"
                : expanded ? "translateY(0)" : "translateY(-12px)",
            },
          ],
          {
            duration: reducedMotion.matches ? 120 : expanded ? 320 : 200,
            easing: reducedMotion.matches
              ? "ease-out"
              : "cubic-bezier(0.22, 1, 0.36, 1)",
            fill: "both",
          },
        );
        drawerAnimation = animation;
        animation.onfinish = () => {
          if (drawerAnimation !== animation) return;
          drawer.hidden = !expanded;
          animation.cancel();
          drawerAnimation = null;
        };
      }

      if (restoreFocus) {
        button.focus({ preventScroll: true });
      }
    };

    drawer.hidden = true;
    setOpen(false);
    header.dataset.enhanced = "";
    button.hidden = false;

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        button.getAttribute("aria-expanded") === "true"
      ) {
        event.preventDefault();
        setOpen(false, true);
      }
    });

    drawer.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;

      const link = event.target.closest<HTMLAnchorElement>("a[href]");
      if (!link) return;

      setOpen(false);

      const destination = new URL(link.href);
      const samePage =
        destination.origin === window.location.origin &&
        destination.pathname === window.location.pathname &&
        destination.search === window.location.search;

      if (samePage && destination.hash) {
        const target = document.getElementById(
          decodeURIComponent(destination.hash.slice(1)),
        );

        if (target) {
          if (!target.hasAttribute("tabindex")) {
            target.setAttribute("tabindex", "-1");
            target.addEventListener(
              "blur",
              () => target.removeAttribute("tabindex"),
              { once: true },
            );
          }

          target.focus({ preventScroll: true });
          return;
        }
      }

      button.focus({ preventScroll: true });
    });

    document.addEventListener("click", (event) => {
      if (
        event.target instanceof Node &&
        !header.contains(event.target) &&
        button.getAttribute("aria-expanded") === "true"
      ) {
        setOpen(false, drawer.contains(document.activeElement));
      }
    });

    mobile.addEventListener("change", () => {
      const focusWasInDrawer = drawer.contains(document.activeElement);
      const focusWasOnButton = document.activeElement === button;

      setOpen(false);

      if (focusWasInDrawer || (focusWasOnButton && !mobile.matches)) {
        const target = mobile.matches ? button : homeLink;
        target.focus({ preventScroll: true });
      }
    });

    reducedMotion.addEventListener("change", () => {
      setOpen(button.getAttribute("aria-expanded") === "true");
    });
  }
</script>

<header class="event-header" data-header>
  <div class="header-row">
    <a
      class="logo-link"
      href="/#top"
      aria-label="AWS Student Community Day Mindanao home"
      data-home-link
    >
      <img src="/assets/logos/scd_logo_1.svg" alt="" width="116" height="66" />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        links.map(({ label, href }) => (
          <Button
            label={label}
            href={href}
            variant="ghost"
            size="sm"
            class="header-nav-link"
          />
        ))
      }
    </nav>

    <Button
      label="Buy Tickets"
      href={ticketUrl}
      variant="outlined"
      class="ticket-link"
    />
    <Button
      label="Menu"
      iconOnly
      variant="outlined"
      size="sm"
      class="menu-button"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      data-menu-button
      hidden
    >
      <svg
        slot="icon-start"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </Button>
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-drawer"
    aria-label="Mobile primary"
    data-mobile-drawer
  >
    {
      links.map(({ label, href }) => (
        <Button
          label={label}
          href={href}
          variant="ghost"
          size="sm"
          class="header-nav-link"
        />
      ))
    }
  </nav>
</header>

<style>
  .event-header {
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 1369px;
    margin-inline: auto;
    border-radius: 0 0 64px 64px;
    background: rgb(50 7 118 / 75%);
    color: white;
    font-family: "Amazon Ember Display", sans-serif;
    font-size: 20px;
    font-weight: 700;
  }

  .event-header::after {
    position: absolute;
    inset: 0;
    border: 2px solid transparent;
    border-top: 0;
    border-radius: inherit;
    background: linear-gradient(to bottom, #320776, #300bab 48.08%, #9f2ce5)
      border-box;
    mask:
      linear-gradient(#fff 0 0) padding-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    content: "";
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 40px;
    min-height: 100px;
    padding: 16px 80px;
  }

  .logo-link {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 44px;
  }

  .logo-link img {
    display: block;
    width: 116.474px;
    height: 66px;
    object-fit: contain;
  }

  .desktop-nav {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-evenly;
    gap: 24px;
    min-width: 0;
  }

  .logo-link {
    color: inherit;
    text-decoration: none;
  }

  .desktop-nav :global(.header-nav-link) {
    flex-shrink: 0;
    min-height: 44px;
    padding: 8px 12px;
    font-size: inherit;
    white-space: nowrap;
  }

  .event-header :global(.ticket-link) {
    flex: 0 0 auto;
    min-width: 174px;
    min-height: 64px;
    padding: 12px 24px;
    font-size: inherit;
    white-space: nowrap;
  }

  .logo-link:focus-visible {
    outline: 3px solid #ffdd00;
    outline-offset: 5px;
  }

  .event-header :global(.menu-button),
  .mobile-drawer {
    display: none;
  }

  .event-header :global([hidden]),
  .event-header :global(.menu-button[hidden]) {
    display: none;
  }

  .event-header :global(.menu-button) {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: 8px;
  }

  @media (max-width: 1100px) {
    .header-row {
      gap: 20px;
      padding-inline: 32px;
    }

    .desktop-nav {
      gap: 12px;
    }

    .event-header :global(.ticket-link) {
      min-width: 150px;
    }
  }

  @media (max-width: 900px) and (min-width: 768px) {
    .event-header {
      font-size: 18px;
    }

    .header-row {
      gap: 16px;
      padding-inline: 24px;
    }

    .logo-link img {
      width: 100px;
      height: auto;
    }

    .desktop-nav :global(.header-nav-link) {
      padding-inline: 6px;
    }

    .event-header :global(.ticket-link) {
      min-width: 140px;
      padding-inline: 16px;
    }
  }

  @media (max-width: 767px) {
    .event-header {
      border-radius: 0 0 28px 28px;
      font-size: 16px;
    }

    .header-row {
      gap: 12px;
      min-height: 80px;
      padding: 12px 20px;
    }

    .logo-link img {
      width: 88px;
      height: auto;
    }

    .desktop-nav {
      display: none;
    }

    .event-header :global(.ticket-link) {
      min-width: 0;
      min-height: 44px;
      margin-left: auto;
      padding: 10px 16px;
    }

    .event-header :global(.menu-button) {
      display: inline-flex;
    }

    .mobile-drawer {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 257px;
      padding: 23px 24px 22px;
      border-radius: 32px;
      background: #320776BF;
    }

    .mobile-drawer::before {
      position: absolute;
      inset: 0;
      border: 1px solid transparent;
      border-bottom: 0;
      border-radius: inherit;
      background: linear-gradient(
          180deg,
          #9F2CE5 0%,
          #300BAB 51.92%,
          #320776 100%
        ) border-box;
      mask:
        linear-gradient(#fff 0 0) padding-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      pointer-events: none;
      content: "";
    }

    .event-header[data-enhanced] .mobile-drawer {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      min-height: 0;
      max-height: calc(100dvh - 96px);
      overflow-y: auto;
    }

    .mobile-drawer :global(.header-nav-link) {
      justify-content: center;
      width: 100%;
      min-height: 44px;
      padding: 10px 12px;
      font-size: inherit;
    }
  }

  @media (max-width: 359px) {
    .header-row {
      gap: 8px;
      padding-inline: 12px;
    }

    .logo-link img {
      width: 72px;
    }

    .event-header :global(.ticket-link) {
      padding-inline: 12px;
      font-size: 14px;
    }
  }
</style>

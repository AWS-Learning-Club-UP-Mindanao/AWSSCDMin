---
import Section from "./layout/Section.astro";
import Button from "./Button.astro";
import ShootingStars from "./ShootingStars.astro";
import { contactEmail, socials } from "../data/site";
import { Image } from "astro:assets";
import logo from "../assets/logos/scd_logo_2.webp";
---

<Section id="cta" spacing="none" class="bg-[#020110]">
  <div class="flex min-h-[66vw] flex-col items-center justify-center py-16 text-center md:py-24">
    <Image
      src={logo}
      widths={[480, 640, 800, 1320]}
      quality={70}
      sizes="(min-width: 1024px) min(38vw, 660px), (min-width: 768px) 46vw, (min-width: 640px) 58vw, 70vw"
      alt="AWS Student Community Day Mindanao 2026"
      loading="eager"
      data-reveal
      class="w-[70vw] max-w-[660px] mix-blend-lighten sm:w-[58vw] md:w-[46vw] lg:w-[38vw]"
    />

    <Button
      label="Get Tickets"
      href="#tickets"
      variant="cta"
      class="mt-10 md:mt-12"
    />

    <p data-reveal class="mt-6 text-caption font-body text-content-secondary md:text-body">
      For inquiries, contact us at&#32;
      <Button
        variant="ghost"
        size="sm"
        href={`mailto:${contactEmail}`}
        label={contactEmail}
        class="-mx-4 text-caption md:text-body"
      />
    </p>

    <nav aria-label="Social media" class="mt-4 flex items-center gap-3">
      {socials.map(({ label, href, icon }) => (
        <a
          href={href}
          aria-label={label}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full transition-transform hover:scale-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface-accent"
        >
          <img
            src={icon}
            alt=""
            aria-hidden="true"
            width="36"
            height="36"
            class="size-6 md:size-9"
          />
        </a>
      ))}
    </nav>
  </div>

  <Fragment slot="decorations">
    {/* Glow + nebulae are masked so they fade in from the top edge instead of starting on a hard line. */}
    <div aria-hidden="true" class="footer-glow pointer-events-none absolute inset-0">
      <div
        class="absolute inset-0 bg-[radial-gradient(44.86%_44.85%_at_50%_40%,#320776_0%,#130445_50%,#020110_100%)]"
      ></div>
      <img
        src="/assets/decorations/nebulae.svg"
        alt=""
        decoding="async"
        class="absolute inset-0 top-[-5rem] h-full w-full object-cover"
      />
    </div>

    <img
      src="/assets/backgrounds/star_background.svg"
      alt=""
      decoding="async"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
    />

    <ShootingStars />
  </Fragment>
</Section>

<style>
  .footer-glow {
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }
</style>

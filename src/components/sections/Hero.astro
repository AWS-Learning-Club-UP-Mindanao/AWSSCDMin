---
import Section from '../layout/Section.astro';
import Button from '../Button.astro';
import { ticketSales } from '../../data/ticket-tiers';
import ShootingStars from '../ShootingStars.astro';
import { heroLogo, heroLogoSizes } from '../../assets/logos/hero-logo';
import starsSvg from '../../../public/assets/backgrounds/star_background.svg?raw';
import nebulaeSvg from '../../../public/assets/decorations/nebulae_hero.svg?raw';
import nebulaeExtSvg from '../../../public/assets/decorations/nebulae_extension.svg?raw';

// The backdrop SVGs are inlined (~10 KB compressed in total) so they paint with the HTML instead of
// popping in one download at a time. They're marked data-loaded up front so BaseLayout doesn't hide them.
// Only escapes what a data URI needs; encodeURIComponent escapes every space and quote, which cost
// ~8 KB more after compression. Assumes the SVGs have no single quotes (Figma exports don't).
const svgUri = (svg: string) =>
	`data:image/svg+xml,${svg.replace(/"/g, "'").replace(/\s+/g, ' ').replace(/[%#<>{}]/g, encodeURIComponent)}`;
---

<Section
	id="hero"
	spacing="hero"
	class="max-md:[--hero-pad:32px] min-h-[calc(100svh+var(--hero-extra))] bg-surface-primary"
>
	<!-- The min-height is the hero's finished height (content box + padding + spacer), set up front. The
	     inlined decorations come before the content in the HTML, so on a slow connection the browser
	     paints them while the hero is still empty; without this they'd be placed against a 64px-tall
	     hero and jump down once the content arrives. -->
	<div class="hero-content flex min-h-[calc(100svh-2*var(--hero-pad))] flex-col items-center justify-center text-center">
		<img
			{...heroLogo.attributes}
			src={heroLogo.src}
			srcset={heroLogo.srcSet.attribute}
			sizes={heroLogoSizes}
			alt="AWS Student Community Day Mindanao 2026"
			loading="eager"
			decoding="auto"
			fetchpriority="high"
			draggable="false"
			class="select-none [-webkit-user-drag:none] aspect-[255/173] w-[min(92.6vw,364px)] mix-blend-lighten min-[393px]:w-[calc(43.9vw_+_191.5px)] lg:w-[calc(25.57vw_+_200px)] min-[1728px]:w-[47.5vw] min-[1728px]:max-w-[1500px]"
		/>

		<Button
			label="Get Tickets"
			href="#tickets"
			variant="cta"
			disabled={!ticketSales.open}
			class="mt-10 w-fit shrink-0 whitespace-nowrap md:mt-12"
		/>
	</div>
	<script is:inline>
		{
			// Logo and button fade in together once the logo and the button's font are in, at most 1s
			// so a slow connection still sees the content. Waits for load, not just decode, so BaseLayout
			// has already marked the logo data-loaded and it isn't still hidden.
			const content = document.currentScript.previousElementSibling;
			const img = content.querySelector('img');
			const loaded = img.complete
				? Promise.resolve()
				: new Promise((r) => {
						img.addEventListener('load', r, { once: true });
						img.addEventListener('error', r, { once: true });
					});
			Promise.race([
				Promise.all([
					loaded.then(() => img.decode()).catch(() => {}),
					document.fonts.load('700 1em "Amazon Ember Display"').catch(() => {}),
				]),
				new Promise((r) => setTimeout(r, 1000)),
			]).then(() => content.setAttribute('data-ready', ''));
		}
	</script>

	<!-- Reserves extra hero height for the absolutely positioned title -->
	<div class="hero-spacer" aria-hidden="true"></div>

	<Fragment slot="decorations">
		<div aria-hidden="true" class="hero-layer hero-bg -z-30"></div>

		<img
			src={svgUri(nebulaeSvg)}
			width="2077"
			height="1307"
			alt=""
			aria-hidden="true"
			data-loaded
			decoding="sync"
			class="hero-layer nebulae-hero"
		/>

		<img
			src={svgUri(nebulaeExtSvg)}
			width="1024"
			height="1471"
			alt=""
			data-loaded
			decoding="sync"
			class="nebulae-extension"
		/>

		<div
			aria-hidden="true"
			class="star-bg pointer-events-none absolute inset-x-0 top-0 -z-20 w-full"
			style={`background-image: url("${svgUri(starsSvg)}")`}
		></div>

		<ShootingStars x={0.6} class="hero-shooting -z-20" />
	</Fragment>
</Section>

<style>
	/* ---------- Logo + button reveal (see the inline script). screen only, and only once JS has
	   tagged the page, so print and no-JS still show it ---------- */
	@media screen {
		:global([data-reveal-ready]) .hero-content:not([data-ready]) {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-content {
			transition: opacity 400ms ease-out;
		}
	}

	/* ---------- Hero extra height (shared by spacer, layers, extension) ---------- */
	:global(:root) {
		--hero-extra: 0vw;
	}

	@media (max-width: 767px) {
		:global(:root) {
			--hero-extra: 50vw;
		}
	}

	.hero-spacer {
		height: var(--hero-extra);
	}

	/* Layers sized to the ORIGINAL hero height (section minus the extra) */
	.hero-layer {
		position: absolute;
		left: 0;
		top: -4vh;
		width: 100%;
		height: calc(100% - var(--hero-extra));
		pointer-events: none;
	}

	/* ---------- Background glow ---------- */
	.hero-bg {
		background: radial-gradient(60% 30% at 50% 50%, #320776 0%, #130445 65%, #020110 100%);
	}

	@media (min-width: 768px) {
		.hero-bg {
			background: radial-gradient(56% 36% at 50% 50%, #320776 0%, #130445 65%, #020110 100%);
		}
	}

	@media (min-width: 1024px){
		.hero-bg {
			background: radial-gradient(48% 40% at 50% 45.92%, #320776 0%, #130445 65%, #020110 100%);
		}
	}

	/* ---------- Hero nebulae (plain image, no effects) ---------- */
	.nebulae-hero {
		width: 116%;
		max-width: none; /* Tailwind preflight caps img at 100% */
		left: -8%;       /* -(width - 100%) / 2 keeps it centered */
		/* natural height, centered on the layer, so nothing is cropped (cover cut the trail's top) */
		height: auto;
		/* center of the original hero area: the section also contains --hero-extra below it */
		top: calc(50% - var(--hero-extra) / 2);
		translate: 0 -50%;
	}

	/* Tablet: the logo takes up most of the width here, so hold the nebulae at their 1024 pixel size instead of shrinking with the viewport */
	@media (min-width: 768px) and (max-width: 1023px) {
		.nebulae-hero {
			--neb-w: 1188px;   /* 116% of 1024, so the swirl matches the 1024 look */
			width: var(--neb-w);
			left: calc((100% - var(--neb-w)) / 2);
		}
	}

	/* Mobile: bigger and higher, so the swirl shows around the logo instead of behind it */
	@media (max-width: 767px) {
		.nebulae-hero {
			width: 180%;
			left: -40%;   /* -(width - 100%) / 2 keeps it centered */
			top: calc(50% - var(--hero-extra) / 2 - 18px);   /* more px = higher */

			rotate: -8deg;
		}
	}

	/* ---------- Nebulae extension (hangs below the original hero edge) ---------- */
	.nebulae-extension {
		--ext-width: 102%;
		--ext-left: -2%;
		/* Top edge measured from the nebulae's center, so the two keep their spacing at any viewport height.
		   Fluid from -14vw at 768 to -26.2vw at 1024, held proportional above */
		--ext-offset: clamp(-26.2vw, 374.8px - 62.8vw, -14vw);

		position: absolute;
		left: var(--ext-left);
		/* same anchor as .nebulae-hero: the center of the original hero area */
		top: calc(50% - var(--hero-extra) / 2 + var(--ext-offset));
		width: var(--ext-width);
		max-width: none;
		height: auto;
		pointer-events: none;
	}

	/* Mobile (393 design; vw units scale it up to 767) */
	@media (max-width: 767px) {
		.nebulae-extension {
			--ext-width: 122%;
			--ext-left: -18%;
			--ext-offset: -6.9vw;

			rotate: -8deg;
			transform-origin: 50% 30%;
		}
	}

	/* ---------- Star background offset ---------- */
	.star-bg {
		--star-bg-y:10vw;            /* how far the stars are lifted */
		height: calc(100% + var(--star-bg-y)); /* extra height covers the gap left at the bottom */
		translate: 0 calc(-1 * var(--star-bg-y));
		/* the image itself is inlined on the element */
		background-position: center top;
		background-size: cover;
	}

	/* Mobile: the hero is tall and narrow, so cover would crop to a sparse sliver. Tile it smaller instead */
	@media (max-width: 767px) {
		.star-bg {
			background-size: auto 50%;
			background-repeat: repeat-y;
		}
	}

	/* ---------- Shooting stars offset ---------- */
	:global(.hero-shooting) {
		--stars-y: -3vw;             /* desktop: positive moves the stars down */
		translate: 0 var(--stars-y);
	}

	@media (min-width: 768px) and (max-width: 1279px) {
		:global(.hero-shooting) {
			--stars-y: 0vw;
		}
	}

	@media (max-width: 767px) {
		:global(.hero-shooting) {
			--stars-y: 3vw;
		}
	}
</style>

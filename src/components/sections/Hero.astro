---
import Section from '../layout/Section.astro';
import Button from '../Button.astro';
---

<Section
	id="cta"
	spacing="none"
	class="bg-surface-primary"
>
	<div class="flex min-h-[66vw] flex-col items-center justify-center px-4 py-16 text-center md:px-22.5 md:py-24">
		<img
			src="/assets/logos/scd_logo_1.svg"
			alt="AWS Student Community Day Mindanao 2026"
			decoding="async"
			class="aspect-[255/173] h-auto w-[min(92.6vw,364px)] mix-blend-lighten min-[393px]:w-[calc(43.9vw_+_191.5px)] lg:w-[calc(25.57vw_+_379.2px)] min-[1728px]:w-[47.5vw] min-[1728px]:max-w-[1500px]"
		/>

		<Button
			label="Get Ticket"
			href="#tickets"
			variant="cta"
			class="mt-10 w-fit shrink-0 whitespace-nowrap md:mt-12"
		/>
	</div>

	<!-- Reserves extra hero height for the absolutely positioned title -->
	<div class="hero-spacer" aria-hidden="true"></div>

	<!-- The glow shadow behind this is its ::before (see styles) -->
	<section class="about-title">
		<div class="about-heading">
			<h1>What is</h1>
			<img
				src="/assets/decorations/bright_star.svg"
				alt=""
				aria-hidden="true"
				decoding="async"
				class="about-star"
			/>
		</div>
		<h5 class="about-subtitle">AWS Student Community Day Mindanao 2026?</h5>
	</section>

	<Fragment slot="decorations">
		<div aria-hidden="true" class="hero-layer hero-bg"></div>

		<!-- Colored nebulae: SVG is only the shape (mask), color comes from CSS -->
		<div aria-hidden="true" class="hero-layer nebulae-color"></div>

		<!-- Soft glow pass -->
		<div aria-hidden="true" class="hero-layer nebulae-color nebulae-glow"></div>

		<img
			src="/assets/decorations/nebulae_extension.svg"
			alt=""
			decoding="async"
			class="nebulae-extension"
		/>

		<img
			src="/assets/backgrounds/star_background.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute inset-0 h-full w-full object-cover"
		/>

		<img
			src="/assets/backgrounds/shooting_star_background.svg"
			alt=""
			decoding="async"
			class="shooting-stars pointer-events-none absolute inset-0 h-full w-full object-cover object-[60%_100%]"
		/>
	</Fragment>
</Section>

<style>
	/* ---------- Hero extra height (shared by spacer, layers, extension) ---------- */
	:global(:root) {
		--hero-extra: 20vw;
	}

	@media (max-width: 767px) {
		:global(:root) {
			--hero-extra: 45vw;
		}
	}

	.hero-spacer {
		height: var(--hero-extra);
	}

	/* Layers sized to the ORIGINAL hero height (section minus the extra) */
	.hero-layer {
		position: absolute;
		left: 0;
		top: -4vh;
		width: 100%;
		height: calc(100% - var(--hero-extra));
		pointer-events: none;
	}

	/* ---------- Background glow ---------- */
	.hero-bg {
		background: radial-gradient(48% 60.74% at 50% 45.92%, #320776 0%, #130445 65%, #020110 100%);
	}

	@media (min-width: 768px) {
		.hero-bg {
			background: radial-gradient(48% 44% at 50% 45%, #320776 0%, #130445 65%, #020110 100%);
		}
	}

	@media (min-width: 1728px) {
		.hero-bg {
			background: radial-gradient(40.3% 50.72% at 50% 45.92%, #320776 0%, #130445 65%, #020110 100%);
		}
	}

	/* ---------- Hero nebulae (SVG used as mask, color from CSS) ---------- */
	.nebulae-color {
		background:
			radial-gradient(28% 30% at 22% 62%, #ff63e6 0%, rgba(255, 99, 230, 0) 70%),
			radial-gradient(26% 32% at 80% 58%, #c04dff 0%, rgba(192, 77, 255, 0) 70%),
			linear-gradient(100deg, #3a1fe0 0%, #7a3cff 35%, #7a3cff 65%, #4a22e8 100%);

		-webkit-mask-image:
			url('/assets/decorations/nebulae_hero.svg'),
			linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%);
		mask-image:
			url('/assets/decorations/nebulae_hero.svg'),
			linear-gradient(to bottom, transparent 0%, black 30%, black 70%, transparent 100%);
		-webkit-mask-size: cover, 100% 100%;
		mask-size: cover, 100% 100%;
		-webkit-mask-position: center, center;
		mask-position: center, center;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-composite: source-in;
		mask-composite: intersect;

		mix-blend-mode: screen;
		opacity: 0.9;
		will-change: transform;
		isolation: isolate;
	}

	.nebulae-glow {
		mix-blend-mode: plus-lighter;
		opacity: 0.25;
		filter: blur(6px);
	}

	/* ---------- Nebulae extension (hangs below the original hero edge) ---------- */
	.nebulae-extension {
		--ext-width: 100%;
		--ext-left: 0%;
		--ext-overhang: 70vw;

		position: absolute;
		left: var(--ext-left);
		/* offset by the extra height so it stays where it was */
		bottom: calc(var(--hero-extra) - var(--ext-overhang));
		width: var(--ext-width);
		max-width: none;
		height: auto;
		pointer-events: none;
	}

	/* Mobile */
	@media (max-width: 767px) {
		.nebulae-extension {
			--ext-width: 120%;
			--ext-left: -18%;
			--ext-overhang: 116vw;

			rotate: -8deg;
			transform-origin: 50% 30%;
		}
	}

	/* Tablet */
	@media (min-width: 768px) and (max-width: 1279px) {
		.nebulae-extension {
			--ext-width: 100%;
			--ext-left: 0%;
			--ext-overhang: 87vw;
		}
	}

	/* Desktop */
	@media (min-width: 1280px) {
		.nebulae-extension {
			--ext-width: 100%;
			--ext-left: -2%;
			--ext-overhang: 88vw;
		}
	}

	/* ---------- Shooting stars offset ---------- */
	.shooting-stars {
		--stars-y: 2vw;              /* desktop: positive moves the stars down */
		translate: 0 var(--stars-y);
	}

	@media (min-width: 768px) and (max-width: 1279px) {
		.shooting-stars {
			--stars-y: 5vw;
		}
	}

	@media (max-width: 767px) {
		.shooting-stars {
			--stars-y: 9vw;
		}
	}

	/* ---------- About title ---------- */
	.about-title {
		--about-left: 16px;     /* 393px and below */
		--about-bottom: -16vw;  /* distance from the bottom of the (extended) hero */

		position: absolute;
		left: var(--about-left);
		bottom: var(--about-bottom);
		z-index: 1;
		text-align: left;
		max-width: calc(100% - var(--about-left) * 2);
	}

	/* Glow shadow behind the title (base values = your 1440px look) */
	.about-title::before {
		--shadow-w: 896px;
		--shadow-h: 248px;
		--shadow-blur: 113.45px;
		--shadow-x: 0px;   /* nudge left/right from the title's center */
		--shadow-y: 0px;   /* nudge up/down from the title's center */

		content: '';
		position: absolute;
		z-index: 0;
		left: 50%;
		top: 50%;
		width: var(--shadow-w);
		height: var(--shadow-h);
		transform: translate(calc(-50% + var(--shadow-x)), calc(-50% + var(--shadow-y)));

		border-radius: 896px;
		background: var(--surface-secondary, #130445);
		filter: blur(var(--shadow-blur));
		pointer-events: none;
	}

	/* Heading row: "What is" + bright star (above the pill so the star tip overlaps it) */
	.about-heading {
		position: relative;
		z-index: 2;
	}

	.about-title h5 {
		position: relative;
		z-index: 2;
		background: var(--background-image-gradient-content);
		color: var(--color-surface-brand);
		padding: 16px 32px;
		border-radius: 16px;
		box-shadow: 0 0 33.3px 4px rgba(255, 195, 0, 0.85) inset;
	}

	/* Bright star (base values = your 1440px look) */
	.about-star {
		--star-w: 70%;      /* star width relative to the title/pill width */
		--star-left: 26%;   /* distance from the title's left edge */
		--star-y: -120%;    /* negative moves the star down into the pill */

		position: absolute;
		left: var(--star-left);
		bottom: var(--star-y);
		width: var(--star-w);
		max-width: none;
		height: auto;
		pointer-events: none;
	}

	/* ---------- Title left margin ---------- */
	/* 393px -> 1024px: 16px to 80px */
	@media (min-width: 393px) {
		.about-title {
			--about-left: calc(10.143vw - 23.86px);
		}
	}

	/* 1024px -> 1728px: 80px to 180px */
	@media (min-width: 1024px) {
		.about-title {
			--about-left: calc(14.205vw - 65.45px);
		}
	}

	/* 1728px and up: same proportion as the logo */
	@media (min-width: 1728px) {
		.about-title {
			--about-left: 10.42vw;
		}
	}

	/* ---------- Star + shadow per breakpoint ---------- */

	/* 1728px and up */
	@media (min-width: 1728px) {
		.about-title::before {
			--shadow-w: 896px;
			--shadow-h: 274px;
			--shadow-blur: 113.45px;
			--shadow-x: 0px;
			--shadow-y: 0px;
		}

		.about-star {
			--star-w: 70%;
			--star-left: 26%;
			--star-y: -120%;
		}
	}

	/* 768px to 1279px (tuned for 1024px) */
	@media (min-width: 768px) and (max-width: 1279px) {
		.about-title::before {
			--shadow-w: 640px;
			--shadow-h: 210px;
			--shadow-blur: 80px;
			--shadow-x: 0px;
			--shadow-y: 0px;
		}

		.about-star {
			--star-w: 60%;
			--star-left: 26%;
			--star-y: -110%;
		}
	}

	/* 768px to 1023px: star ramps from the 768 values to the 1024 values */
	@media (min-width: 768px) and (max-width: 1023px) {
		.about-title::before {
			--shadow-w: 600px;
			--shadow-h: 180px;
			--shadow-blur: 80px;
			--shadow-x: 0px;
			--shadow-y: 0px;
		}

		.about-star {
			--star-w: calc(40% + 1.953vw);
			--star-left: calc(-24% + 24vw);
			--star-y: calc(-70% - 2vw);
		}
	}

	/* Mobile (tuned for 393px): centered title */
	@media (max-width: 767px) {
		.about-title {
			--about-left: 0px;
			--about-bottom: -6vw;

			left: 0;
			right: 0;
			margin-inline: auto;
			width: min(295px, calc(100vw - 32px));
			max-width: none;
			text-align: center;
		}

		.about-title::before {
			--shadow-w: 100vw;
			--shadow-h: 30vw;
			--shadow-blur: 70px;
			--shadow-x: 0px;
			--shadow-y: 0px;
		}

		.about-title h1 {
			padding-right: 30px;
		}

		.about-title h5 {
			border-radius: 12px;
			padding: 8px 32px;
			width: 100%;
		}

		.about-star {
			--star-w: 55%;
			--star-left: 50%;
			--star-y: -105%;
		}
	}
</style>
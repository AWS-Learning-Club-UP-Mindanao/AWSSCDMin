---
import Section from '../layout/Section.astro';

const text =
	'AWS Student Community Day Davao 2025 is a student-led cloud technology event that unites students, educators, and tech enthusiasts across Davao and nearby regions to learn, collaborate, and innovate through Amazon Web Services.';
const words = text.split(' ');
---

<Section
	id="about"
	spacing="none"
	class="bg-gradient-banner shadow-brand px-[clamp(32px,calc(28.5vw_-_80px),330px)] py-[clamp(64px,calc(4.9vw_+_45px),95px)]"
>
	<p class="text-h5 md:text-h4 text-content-secondary text-pretty" data-scroll-reveal>
		{
			words.map((word) => (
				<>
					<span class="reveal-word">{word}</span>{' '}
				</>
			))
		}
	</p>
</Section>

<style>
	.reveal-word[data-lit] {
		color: var(--color-content-primary);
	}
</style>

<script>
	const heading = document.querySelector<HTMLElement>('[data-scroll-reveal]');

	if (heading) {
		const words = heading.querySelectorAll<HTMLElement>('.reveal-word');
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let ticking = false;

		const update = () => {
			const vh = window.innerHeight;
			const { top } = heading.getBoundingClientRect();

			// 0 when the heading's top is at 85% of the viewport, 1 once it reaches 35%
			const progress = reduceMotion
				? 1
				: Math.min(1, Math.max(0, (vh * 0.85 - top) / (vh * 0.5)));

			const litCount = Math.ceil(progress * words.length);
			words.forEach((word, i) => word.toggleAttribute('data-lit', i < litCount));
			ticking = false;
		};

		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		update();
	}
</script>
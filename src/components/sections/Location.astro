---
import Section from "../layout/Section.astro";
import { venue } from "../../data/site";

const key = import.meta.env.GOOGLE_MAPS_API_KEY;

/* The interactive map uses the Maps JavaScript API, which is the only Maps API this key is allowed
   to call. The bootstrap is probed at build time: a rejected key and a keyless build both fall back
   to the exported frame image, which is what CI does. */
// The key is confirmed at runtime: a refused key fires gm_authFailure, which removes
// the map so the frame image underneath shows.
const interactive = Boolean(key);
---

<Section
  id="location"
  class="bg-[radial-gradient(ellipse_closest-side,var(--color-surface-secondary,#130445)_0%,var(--color-surface-primary,#020110)_100%)]"
  backgroundImage="/assets/backgrounds/star_background.svg"
>
    <div class="grid items-center gap-10 xl:grid-cols-[514fr_790fr] xl:gap-16">
      <div class="flex flex-col gap-4" data-reveal>
        <h2 class="text-h1 text-content-primary">Location</h2>
        <h3
          class="-mt-4 text-[22px]/[32px] font-body font-bold md:text-[28px]/[40px]"
          style="background: var(--background-image-gradient-content); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: transparent;"
        >
          {venue.name}
        </h3>
        <p class="text-body text-content-secondary">
          More details soon.
        </p>
        {venue.address && (
          <p class="text-body text-content-secondary text-pretty">
            {venue.address}
          </p>
        )}
      </div>

      {interactive ? (
        <div
          data-reveal
          role="region"
          aria-label={`Map of ${venue.name}`}
          class="relative aspect-[357/369] w-full overflow-hidden rounded-2xl bg-[url('/assets/maps/venue-map.webp')] bg-cover bg-center md:aspect-[859/331] xl:aspect-[790/496]"
        >
          <gmp-map
            center={`${venue.mapCenter.lat},${venue.mapCenter.lng}`}
            zoom={String(venue.mapZoom)}
            map-id={venue.mapId}
            class="absolute inset-0 h-full w-full"
          >
            <gmp-advanced-marker
              position={`${venue.mapCenter.lat},${venue.mapCenter.lng}`}
              title="Ateneo de Davao University"
            />
          </gmp-map>
        </div>
      ) : (
        <img
          src={venue.mapFallbackSrc}
          alt=""
          decoding="async"
          loading="lazy"
          data-reveal
          class="aspect-[357/369] w-full rounded-2xl object-cover md:aspect-[859/331] xl:aspect-[790/496]"
        />
      )}
    </div>

  <Fragment slot="decorations">
    {/* Same approach as Schedule: the glow is a % of the section so it scales at every size.
        The mask feathers all four edges so the blur fades out instead of clipping. */}
    <div aria-hidden="true" class="location-glow pointer-events-none absolute inset-0">
      <div class="absolute left-1/2 top-1/2 h-[85%] w-[90%] -translate-x-1/2 -translate-y-1/2 rounded-full bg-surface-secondary blur-[120px] md:w-[70%] md:blur-[200px]"></div>
    </div>

    <div class="pointer-events-none absolute inset-0 mx-auto w-full max-w-[1400px]">
      <img
        src="/assets/decorations/north-star-location.svg"
        data-play-in-view
        alt=""
        decoding="async"
        class="absolute left-[10rem] top-[-2rem] w-[11rem] md:left-[14rem] md:top-[0rem] md:w-[13rem] lg:left-[18rem] lg:top-[3rem] lg:w-[16rem] xl:top-[4rem] -translate-y-[5%]"
      />
    </div>
  </Fragment>
</Section>

<style>
  .location-glow {
    --fade-y: linear-gradient(to bottom, transparent, #000 15%, #000 85%, transparent);
    --fade-x: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-image: var(--fade-y), var(--fade-x);
    mask-composite: intersect;
    -webkit-mask-image: var(--fade-y), var(--fade-x);
    -webkit-mask-composite: source-in;
  }
</style>

{interactive && (
  <>
    <script is:inline>
      /* Google calls this when the key is refused, for example when the request's referrer is
				   not on the key's allow list. Hiding the map lets the frame image behind it show. */
      window.gm_authFailure = function () {
        const map = document.querySelector("#location gmp-map");
        if (map) map.remove();
        console.error(
          "[location] Google Maps refused this key. If the console says ApiTargetBlockedMapError, allow Maps JavaScript API in the key restrictions.",
        );
      };
    </script>
    <script
      is:inline
      define:vars={{ mapsSrc: `https://maps.googleapis.com/maps/api/js?key=${key}&libraries=maps,marker&v=beta&loading=async` }}
    >
      /* gmp-map upgrades itself when the API arrives, so the script can wait until the
         section is near the viewport. The frame image behind it covers the gap. */
      (() => {
        const map = document.querySelector("#location gmp-map");
        if (!map) return;
        const load = () => {
          if (document.querySelector("script[data-maps-api]")) return;
          const s = document.createElement("script");
          s.src = mapsSrc;
          s.async = true;
          s.dataset.mapsApi = "";
          document.head.appendChild(s);
        };
        if (!("IntersectionObserver" in window)) return load();
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              load();
            }
          },
          { rootMargin: "400px 0px" },
        );
        io.observe(map);
      })();
    </script>
  </>
)}

---
import Section from '../layout/Section.astro';
import ScheduleItem from '../ScheduleItem.astro';
import { schedule } from '../../data/schedule';
---

<Section
	id="schedule"
	spacing="none"
	class="bg-[radial-gradient(circle,var(--color-surface-secondary,#130445)_0%,var(--color-surface-primary,#020110)_100%)] pt-40 pb-[50vh] md:pt-56 md:pb-[54vh] lg:pt-72 lg:pb-[58vh]"
	backgroundImage="/assets/backgrounds/star_background.svg"
>
	<h2 class="mb-16 text-center text-h1 font-display text-content-primary md:mb-24">Schedule Timeline</h2>

	<ol class="mx-auto w-full max-w-[820px] space-y-8 md:space-y-10">
		{
			schedule.map((slot, i) => (
				<li class="relative grid grid-cols-[4.5rem_1fr] gap-x-4 md:grid-cols-[9.5rem_5rem_1fr] md:gap-x-0">
					<div class="md:text-right">
						<p class="text-h4 font-body text-content-primary">{slot.label}</p>
						<p class="mt-1 text-body font-body text-content-secondary md:whitespace-nowrap">{slot.time}</p>
					</div>

					<div class="hidden md:mt-[18px] md:flex md:items-center md:self-start">
						<span
							class="relative z-[1] ml-[38px] h-3 w-3 shrink-0 rounded-full bg-surface-brand-secondary"
						></span>
						<span class="h-[2px] flex-1 bg-surface-brand-secondary"></span>
					</div>

					{
						i === 0 && (
							<span
								aria-hidden="true"
								class="absolute -top-[16px] left-[195px] hidden h-10 w-[1px] bg-linear-to-b from-transparent to-surface-brand md:block"
							/>
						)
					}
					{
						i < schedule.length - 1 ? (
							<span
								aria-hidden="true"
								class="absolute top-[24px] left-[195px] hidden h-[calc(100%_+_2.5rem)] w-[1px] bg-surface-brand md:block"
							/>
						) : (
							<span
								aria-hidden="true"
								class="absolute top-[24px] left-[195px] hidden h-10 w-[1px] bg-linear-to-b from-surface-brand to-transparent md:block"
							/>
						)
					}

					<div class="space-y-4 text-h2">
						{slot.rows.map((row) => (
							<div class:list={['grid gap-4', row.length > 1 && 'md:grid-cols-2']}>
								{row.map((session) => <ScheduleItem session={session} />)}
							</div>
						))}
					</div>
				</li>
			))
		}
	</ol>


	<Fragment slot="decorations">

<!-- Shooting star background also bleeds from hero into schedule
		<img
src="assets/backgrounds/shooting_star_background.svg"
			alt=""
			decoding="async"
			class="rotate-z-180 pointer-events-none absolute inset-0 h-full w-full object-cover"
		/>
-->

  <!--Star trail from hero bleeds into schedule-->
		<img
				src="/assets/decorations/bright_star.svg"
				alt=""
				decoding="async"
        class="pointer-events-none absolute overflow-visible
                top-[9vh] right-[9vw] w-[23vw] scale-120
                sm:top-[8vh] sm:right-[9vw] sm:w-[23vw] sm:scale-90
                md:top-[11vh] md:left-[68vw] md:w-[23vw] md:scale-120
                lg:top-[13vh] lg:left-[68vw] lg:w-[23vw] lg:scale-120
                xl:top-[10vh] xl:left-[66vw] xl:w-[22vw] xl:scale-120
                2xl:top-[9vh] 2xl:left-[60vw] 2xl:w-[23vw] 2xl:scale-120
                3xl:top-[0vh] 3xl:left-[60vw] 3xl:w-[23vw] 3xl:scale-90"

			/>

			<img
				src="/assets/decorations/bright_star.svg"
				alt=""
				decoding="async"
				class="pointer-events-none absolute
				       top-[14vh] right-[19vw] w-[15vw] scale-90
				       sm:top-[14vh] sm:right[19vw] sm:w-[15vw] sm:scale-90
				       md:top-[19vh] md:left-[66vw] md:w-[15vw] md:scale-90
				       lg:top-[24vh] lg:left-[66vw] lg:w-[15vw] lg:scale-90
				       xl:top-[23vh] xl:left-[65vw] xl:w-[15vw] xl:scale-90
				       2xl:top-[23vh] 2xl:left-[57vw] 2xl:w-[15vw] 2xl:scale-70
				       3xl:top-[15vh] 2xl:left-[57vw] 2xl:w-[15vw] 2xl:scale-70"
                />

		<img
			src="/assets/decorations/constellation_1.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute top-[37vw] right-[15vw] hidden w-[12rem] translate-x-1/2 xl:block"
		/>
		<img
			src="/assets/decorations/constellation_2.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute bottom-[40vh] left-[19vw] w-[5rem] -translate-x-1/2
			       sm:w-[6rem]
			       md:w-[7.5rem]
			       lg:w-[9rem]
			       xl:w-[10rem]"
		/>
		<img
			src="/assets/decorations/northstar_ticket.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute bottom-[-23vh] left-1/2 -translate-x-1/2  overflow-visible max-w-none
			       w-[115vw]
			       sm:w-[110vw] sm:bottom-[-7vh]
			       md:w-[105vw] md:bottom-[-8vh]
			       lg:w-[102vw] lg:bottom-[-11vh]
			       xl:w-[100vw] xl:bottom-[-14vh]
			       2xl:w-[100vw] 2xl:bottom-[-16vh]
			       3xl:w-[100vw] 3xl:bottom-[-20vh]"
		/>

	</Fragment>
</Section>

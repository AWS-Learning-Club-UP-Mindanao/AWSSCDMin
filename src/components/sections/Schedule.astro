---
import Section from '../layout/Section.astro';
import ScheduleItem from '../ScheduleItem.astro';
import { schedule } from '../../data/schedule';
---

<!--
	The design has no visible heading over the timeline, so the heading is kept for the
	document outline only and the timeline reads straight off the section.

	The radial background is set here because the schedule frame sits on it. If that gradient
	turns out to belong on the page rather than on one section, drop this class.
-->
<Section
	id="schedule"
	spacing="none"
	class="bg-gradient-radial py-32 md:py-48 lg:py-64"
	backgroundImage="/assets/backgrounds/star_background.svg"
>
	<h2 class="mb-16 text-center text-h1 font-display text-content-primary md:mb-24">Schedule Timeline</h2>

	<ol class="mx-auto w-full max-w-[820px] space-y-8 md:space-y-10">
		{
			schedule.map((slot) => (
				<li class="grid grid-cols-[4.5rem_1fr] gap-x-4 md:grid-cols-[9.5rem_5rem_1fr] md:gap-x-0">
					<div class="md:text-right">
						<p class="text-h4 font-body text-content-primary">{slot.label}</p>
						<p class="mt-1 text-body font-body text-content-secondary md:whitespace-nowrap">{slot.time}</p>
					</div>

					<!-- The frame runs a short rule from the time across to the card. -->
					<div class="hidden md:flex md:items-center">
						<span class="h-px w-full bg-surface-brand-secondary"></span>
					</div>

					<div class="space-y-4 text-h2">
						{slot.rows.map((row) => (
							<div class:list={['grid gap-4', row.length > 1 && 'md:grid-cols-2']}>
								{row.map((session) => <ScheduleItem session={session} />)}
							</div>
						))}
					</div>
				</li>
			))
		}
	</ol>


	<Fragment slot="decorations">

<!-- Shooting star background also bleeds from hero into schedule
		<img
src="assets/backgrounds/shooting_star_background.svg"
			alt=""
			decoding="async"
			class="rotate-z-180 pointer-events-none absolute inset-0 h-full w-full object-cover"
		/>
-->

  <!--Star trail from hero bleeds into schedule-->

		<!--
			Positioning these against the section does not survive a resize. The decorations
			layer spans the whole section, which is as wide as the window, so a plain
			`left-380` (1520px) is measured from the window's edge and bears no relation to
			the timeline - centred, 820px wide, and at a different offset at every width.
			It looks right on one monitor and gets clipped away on a narrower one.

			This band mirrors the content column: same 1400px max, same 32/48px gutters, same
			centring. Anchors inside it keep their position relative to the timeline at any
			width. Two habits keep it stable:

			  anchor to an edge     -top-*, -right-*, bottom-*  survives the column shrinking
			  avoid big left-*      left-[1350px] only looks right while the column is at max

			Sizes still need to be responsive - an SVG with no w-* class renders at its
			intrinsic 350px on a phone.
		-->
		<div class="pointer-events-none absolute inset-y-0 left-1/2 w-full max-w-[1400px] -translate-x-1/2">
			<img
				src="/assets/decorations/bright_star.svg"
				alt=""
				decoding="async"
				class="pointer-events-none absolute top-20 left-245 w-80 scale-120 md:w-72"
			/>

			<img
				src="/assets/decorations/bright_star.svg"
				alt=""
				decoding="async"
				class="pointer-events-none absolute top-70 left-250 w-48 scale-120 md:w-32"
			/>
		</div>

		<img
			src="/assets/decorations/constellation_1.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute top-24 right-0 hidden w-[26rem] translate-x-1/2 xl:block"
		/>
		<img
			src="/assets/decorations/constellation_2.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute bottom-24 left-0 hidden w-[24rem] -translate-x-1/2 xl:block"
		/>
	</Fragment>
</Section>

---
import Section from '../layout/Section.astro';
import ScheduleItem from '../ScheduleItem.astro';
import { schedule } from '../../data/schedule';
---

<Section
	id="schedule"
	spacing="none"
	class="bg-[radial-gradient(circle,var(--color-surface-secondary,#130445)_0%,var(--color-surface-primary,#020110)_100%)] pt-40 pb-[50vh] md:pt-56 md:pb-[54vh] lg:pt-72 lg:pb-[58vh]"
	backgroundImage="/assets/backgrounds/star_background.svg"
>
	<h2 class="mb-16 text-center text-h1 font-display text-content-primary md:mb-24">Schedule Timeline</h2>

	<ol class="mx-auto w-full max-w-[820px] space-y-8 md:space-y-10">
		{
			schedule.map((slot, i) => (
				<li class="relative grid grid-cols-[4.5rem_2.5rem_1fr] md:grid-cols-[9.5rem_5rem_1fr]">
					<div class="md:text-right">
						<p class="text-h4 font-body text-content-primary">{slot.label}</p>
						<p class="mt-1 text-body font-body text-content-secondary md:whitespace-nowrap">{slot.time}</p>
					</div>

					<div class="mt-[18px] flex items-center self-start">
						<span
							class="connector-dot relative z-[1] ml-[14px] h-3 w-3 shrink-0 rounded-full bg-surface-brand-secondary md:ml-[38px]"
						></span>
						<span class="connector-line h-[2px] flex-1 bg-surface-brand-secondary"></span>
					</div>

					{
						i === 0 && (
							<span
								aria-hidden="true"
								class="absolute -top-[16px] left-[91px] h-10 w-[1px] bg-linear-to-b from-transparent to-surface-brand md:left-[195px]"
							/>
						)
					}
					{
						i < schedule.length - 1 ? (
							<span
								aria-hidden="true"
								class="absolute top-[24px] left-[91px] h-[calc(100%_+_2rem)] w-[1px] bg-surface-brand md:left-[195px] md:h-[calc(100%_+_2.5rem)]"
							/>
						) : (
							<span
								aria-hidden="true"
								class="absolute top-[24px] left-[91px] h-10 w-[1px] bg-linear-to-b from-surface-brand to-transparent md:left-[195px]"
							/>
						)
					}

					<div class="space-y-4 text-h2">
						{slot.rows.map((row) => (
							<div class:list={['grid gap-4', row.length > 1 && 'md:grid-cols-2']}>
								{row.map((session) => <ScheduleItem session={session} />)}
							</div>
						))}
					</div>
				</li>
			))
		}
	</ol>


	<Fragment slot="decorations">

<!-- Shooting star background also bleeds from hero into schedule
		<img
src="assets/backgrounds/shooting_star_background.svg"
			alt=""
			decoding="async"
			class="rotate-z-180 pointer-events-none absolute inset-0 h-full w-full object-cover"
		/>
-->

		<!--
			Stars. From md up the single 1727x1057 canvas covers the section. Below md it is tiled
			at its natural size instead: cover would scale it 2.25x and crop to the middle ~10% of
			the width, leaving the top 40% of the section with no stars at all.
		-->
		<div
			aria-hidden="true"
			class="pointer-events-none absolute inset-0 bg-repeat bg-auto bg-[url('/assets/backgrounds/star_background.svg')] md:hidden"
		>
		</div>

		<img
			src="/assets/backgrounds/star_background.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute inset-0 hidden h-full w-full object-cover md:block"
		/>

  <!--Star trail, bleeding in from the hero. Layered twice the way the northstar is:
			a colour-dodge pass and a plus-lighter pass over the same artwork, so the
			trail picks up the section's colour underneath instead of painting flat.-->
		<img
			src="/assets/decorations/star_trail_1.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute overflow-visible mix-blend-color-dodge
			       top-[7vh] right-[-11vw] w-[23vw] scale-120
			       sm:top-[7vh] sm:right-[9vw] sm:w-[23vw] sm:scale-90
			       md:top-[11vh] md:left-[68vw] md:w-[23vw] md:scale-120
			       lg:top-[13vh] lg:left-[68vw] lg:w-[23vw] lg:scale-120
			       xl:top-[11vh] xl:left-[68vw] xl:w-[22vw] xl:scale-120
			       2xl:top-[6vh] 2xl:left-[60vw] 2xl:w-[23vw] 2xl:scale-80
			       3xl:top-[4vh] 3xl:left-[58vw] 3xl:w-[23vw] 3xl:scale-70"
		/>

		<img
			src="/assets/decorations/star_trail_1.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute overflow-visible mix-blend-plus-lighter
			       top-[7vh] right-[-11vw] w-[23vw] scale-120
			       sm:top-[7vh] sm:right-[9vw] sm:w-[23vw] sm:scale-90
			       md:top-[11vh] md:left-[68vw] md:w-[23vw] md:scale-120
			       lg:top-[13vh] lg:left-[68vw] lg:w-[23vw] lg:scale-120
			       xl:top-[11vh] xl:left-[68vw] xl:w-[22vw] xl:scale-120
			       2xl:top-[6vh] 2xl:left-[60vw] 2xl:w-[23vw] 2xl:scale-80
			       3xl:top-[4vh] 3xl:left-[58vw] 3xl:w-[23vw] 3xl:scale-70"
		/>

		<img
			src="/assets/decorations/constellation_1.svg"
			alt=""
			decoding="async"
class="pointer-events-none absolute top-[37vw] right-[22vw] hidden w-[12rem] translate-x-1/2 
xl:right-[11vw] xl:bottom-[10vh] xl:block
2xl:right[11vw] 2xl:bottom-[10vh]
3xl:right-[14vw] 3xl:bottom-[10vh]"
		/>
		<img
			src="/assets/decorations/constellation_2.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute bottom-[40vh] left-[19vw] w-[5rem] -translate-x-1/2
			       sm:w-[6rem]
			       md:w-[7.5rem]
			       lg:w-[9rem]
xl:w-[10rem]
2xl:w-[11rem]
3xl:w-[12rem]"

		/>
		<img
			src="/assets/decorations/northstar_ticket.svg"
			alt=""
			decoding="async"
			class="pointer-events-none absolute bottom-[-23vh] left-1/2 -translate-x-1/2  overflow-visible max-w-none
			       w-[115vw]
			       sm:w-[110vw] sm:bottom-[-7vh]
			       md:w-[105vw] md:bottom-[-8vh]
			       lg:w-[102vw] lg:bottom-[-12vh]
			       xl:w-[100vw] xl:bottom-[-14vh]
			       2xl:w-[100vw] 2xl:bottom-[-16vh]
			       3xl:w-[100vw] 3xl:bottom-[-20vh]"
		/>

	</Fragment>
</Section>

<style>
	/*
	 * The white connector state. Hovering, focusing or tapping a card lights that row's
	 * dot and line white, with a white halo on the dot.
	 *
	 * :has() keeps the rule on the row, where the connector lives, so the card component
	 * does not have to reach sideways into its sibling. The card carries the hover state
	 * and this reads it back.
	 */
	.connector-dot,
	.connector-line {
		transition:
			background-color 200ms ease-in-out,
			box-shadow 200ms ease-in-out;
	}

	li:has(:global(.schedule-item):is(:hover, :focus-within, [data-pressed])) .connector-dot {
		background-color: var(--color-surface-white);
		box-shadow: 0 0 20px 0 var(--color-surface-white);
	}

	li:has(:global(.schedule-item):is(:hover, :focus-within, [data-pressed])) .connector-line {
		background-color: var(--color-surface-white);
	}

	@media (prefers-reduced-motion: reduce) {
		.connector-dot,
		.connector-line {
			transition: none;
		}
	}
</style>

<script>
	/*
	 * Mobile tap. A touch has no hover to leave, so the lit state is set on the tapped
	 * card and held until another card or the page itself is tapped. Only one card is
	 * ever lit, so a two-room timeslot highlights just the room that was tapped.
	 */
	document.addEventListener(
		'touchstart',
		(e) => {
			const target = e.target instanceof Element ? e.target : null;
			const card = target?.closest('.schedule-item');

			document.querySelectorAll('.schedule-item[data-pressed]').forEach((el) => {
				if (el !== card) el.removeAttribute('data-pressed');
			});

			card?.setAttribute('data-pressed', '');
		},
		{ passive: true }
	);
</script>

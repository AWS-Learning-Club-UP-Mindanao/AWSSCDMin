---
import Section from '../layout/Section.astro';
import TicketCard from '../TicketCard.astro';
import { ticketTiers } from '../../data/ticket-tiers';
---

<Section id="tickets" spacing="none" class="z-10 rounded-t-[64px] bg-gradient-tickets pt-16 pb-24 shadow-brand md:pb-32">
	<header class="text-center">
		<h2 class="text-h1 text-content-primary">Select Your Ticket Tier</h2>
		<p class="text-content-secondary">
			Different tickets unlock different access and benefits. Pick the one that’s right for you.
		</p>
	</header>

	<div class="mt-4 md:mt-12 xl:mt-4" data-ticket-carousel>
		<ul
			class="ticket-track relative -mx-8 flex snap-x snap-mandatory gap-6 overflow-x-auto pt-4 pb-10 md:-mx-12 md:gap-16 xl:mx-0 xl:justify-center xl:overflow-visible"
			data-ticket-track
		>
			{
				ticketTiers.map((tier) => (
					<li class="shrink-0 snap-center">
						<TicketCard tier={tier} />
					</li>
				))
			}
		</ul>

		<div class="relative -mt-[22px] flex justify-center xl:hidden">
			{
				ticketTiers.map((tier) => (
					<button
						type="button"
						class="ticket-pill flex h-11 cursor-pointer items-center px-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-surface-accent"
						aria-label={`Show ${tier.name}`}
						aria-current="false"
						data-ticket-pill
					>
						<span class="ticket-pill-dot block h-4 w-4 rounded-full bg-surface-white/50"></span>
					</button>
				))
			}
		</div>
	</div>
</Section>

<style>
	.ticket-track {
		--gutter: 2rem;
		padding-inline: max(0px, calc(50% + var(--gutter) - 164px));
	}

	@media (min-width: 768px) {
		.ticket-track {
			--gutter: 3rem;
		}
	}

	@media (min-width: 1280px) {
		.ticket-track {
			padding-inline: 0;
		}
	}

	.ticket-pill[aria-current='true'] .ticket-pill-dot {
		width: 3rem;
		background-color: var(--color-surface-accent);
	}

	@media (prefers-reduced-motion: no-preference) {
		.ticket-pill-dot {
			transition:
				width 200ms ease-out,
				background-color 200ms ease-out;
		}
	}
</style>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	for (const carousel of document.querySelectorAll<HTMLElement>('[data-ticket-carousel]')) {
		const track = carousel.querySelector<HTMLElement>('[data-ticket-track]');
		if (!track) continue;

		const slides = Array.from(track.children) as HTMLElement[];
		const pills = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-ticket-pill]'));

		const scrollTargetFor = (slide: HTMLElement) =>
			slide.offsetLeft + slide.offsetWidth / 2 - track.clientWidth / 2;

		const nearestIndex = () => {
			let best = 0;
			slides.forEach((slide, i) => {
				const distance = Math.abs(scrollTargetFor(slide) - track.scrollLeft);
				if (distance < Math.abs(scrollTargetFor(slides[best]) - track.scrollLeft)) best = i;
			});
			return best;
		};

		const setActive = (index: number) => {
			pills.forEach((pill, i) => pill.setAttribute('aria-current', String(i === index)));
		};

		let frame = 0;
		track.addEventListener(
			'scroll',
			() => {
				cancelAnimationFrame(frame);
				frame = requestAnimationFrame(() => setActive(nearestIndex()));
			},
			{ passive: true },
		);

		pills.forEach((pill, i) => {
			pill.addEventListener('click', () => {
				track.scrollTo({
					left: scrollTargetFor(slides[i]),
					behavior: reduceMotion.matches ? 'auto' : 'smooth',
				});
			});
		});

		if (track.scrollWidth > track.clientWidth) {
			track.scrollLeft = scrollTargetFor(slides[Math.floor(slides.length / 2)]);
		}
		setActive(nearestIndex());
	}
</script>

---
import Section from '../layout/Section.astro';
import SpeakerCard from '../SpeakerCard.astro';
import { speakers } from '../../data/speakers';
---

<!--
	Bottom padding is the gap from the last card to the divider plus the divider's own 77px:
	276px on the desktop frame, 299px on iPad. The mobile value is an estimate until the frame
	is checked.
-->
<Section
	id="speakers"
	spacing="none"
	class="overflow-x-clip bg-surface-primary pt-32 pb-48 md:pt-60 md:pb-94 xl:pb-88"
>
	<h2 class="mb-16 text-center font-display text-h1 text-content-primary md:mb-32">
		<!--
			The north star ends in the sparkle beside this heading, so the art is anchored to the
			text and sized in em: it follows the heading as text-h1 scales down. Offsets come from
			the desktop frame at 61px, where the art sits 646px left of and 1002.5px above the text.
		-->
		<span class="relative inline-block">
			<img
				src="/assets/decorations/north_star_speakers.svg"
				alt=""
				width="1728"
				height="1647"
				decoding="async"
				class="pointer-events-none absolute top-[-16.434em] left-[-10.59em] -z-10 h-auto w-[28.328em] max-w-none"
			/>
			Meet The Speakers
		</span>
	</h2>

	<ul
		class="mx-auto grid max-w-[336px] grid-cols-1 gap-10 md:max-w-[735px] md:grid-cols-2 md:gap-16 xl:max-w-[1135px] xl:grid-cols-3"
	>
		{
			speakers.map((speaker) => (
				<li>
					<SpeakerCard speaker={speaker} />
				</li>
			))
		}
	</ul>

	<Fragment slot="decorations">
		<!--
			The glow is the same blurred ellipse at every breakpoint, stretched to each frame's
			shape. Each box is the ellipse scaled by the SVG's 400px blur margin (2106/1306 wide,
			2506/1706 tall), centred on the ellipse's offset from the frame's middle. Clipped here
			so its lower half doesn't spill into the location section.
		-->
		<div class="absolute inset-0 overflow-hidden">
			<img
				src="/assets/decorations/glow_speakers.svg"
				alt=""
				width="2106"
				height="2506"
				decoding="async"
				class="absolute top-[-805.5px] left-[calc(50%-7.5px)] h-[4897px] w-[671px] max-w-none -translate-x-1/2 object-fill md:top-[-42.5px] md:left-[calc(50%-19.5px)] md:h-[2779px] md:w-[1404px] xl:top-[-334px] xl:left-[calc(50%-4px)] xl:h-[2506px] xl:w-[2106px]"
			/>
		</div>

		<div class="absolute inset-x-0 bottom-0 h-[77px] bg-gradient-divider shadow-brand"></div>
	</Fragment>
</Section>

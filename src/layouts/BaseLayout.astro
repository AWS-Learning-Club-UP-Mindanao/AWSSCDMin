---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	noindex?: boolean;
}

const {
	title,
	description = 'AWS Student Community Day Mindanao. A one-day student conference on cloud, AI, and building in community.',
	image = '/og_image.webp',
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href="/assets/fonts/amazon-ember-display-bold.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#020110" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="AWS Student Community Day Mindanao" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="4850" />
		<meta property="og:image:height" content="2845" />
		<meta property="og:image:alt" content="AWS Student Community Day Mindanao 2026, November 2026. Build Beyond. Dream Limitless." />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>document.documentElement.dataset.revealReady = '';</script>
		<script is:inline>
			for (const type of ['load', 'error'])
				document.addEventListener(type, (e) => e.target.tagName === 'IMG' && e.target.setAttribute('data-loaded', ''), true);
		</script>
		<slot name="head" />
	</head>
	<body class="bg-surface-primary font-body text-content-primary">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-surface-white focus:px-4 focus:py-2 focus:text-content-brand"
		>
			Skip to content
		</a>

		<slot name="header" />

		<main id="main" class="overflow-x-clip">
			<slot />
		</main>

		<footer>
			<slot name="footer" />
		</footer>

		<script>
			const io = new IntersectionObserver(
				(entries) => {
					for (const { target, isIntersecting } of entries) {
						if (!isIntersecting) continue;
						const img = target as HTMLImageElement;
						io.unobserve(img);
						img.decode().catch(() => {}).then(() => {
							img.src = img.src.split('#')[0] + '#play';
						});
					}
				},
				{ rootMargin: '0px 0px -20% 0px' },
			);
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.querySelectorAll('img[data-play-in-view]').forEach((img) => io.observe(img));
			}
		</script>
	</body>
	<script>
		const observer = new IntersectionObserver(
			(entries) => {
				let i = 0;
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const parent = entry.target.parentElement;
					const batch =
						parent?.dataset.revealStagger === 'together'
							? [...parent.children].filter((c) => pending.has(c) && c.getClientRects().length)
							: [entry.target];
					for (const el of batch as HTMLElement[]) {
						if (!pending.delete(el)) continue;
						el.style.setProperty('--reveal-i', String(Math.min(i++, 6)));
						observer.unobserve(el);
						reveal(el);
					}
				}
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		const pending = new WeakSet<Element>();

		const reveal = (el: HTMLElement) => {
			const imgs = (el.matches('img') ? [el as HTMLImageElement] : [...el.querySelectorAll('img')]).slice(
				0,
				Number(el.dataset.revealWait) || undefined,
			);
			Promise.race([
				Promise.all(imgs.map((img) => img.decode().catch(() => {}))),
				new Promise((r) => setTimeout(r, 1000)),
			]).then(() => el.setAttribute('data-revealed', ''));
		};

		document.querySelectorAll('[data-reveal], [data-reveal-stagger] > *').forEach((el) => {
			pending.add(el);
			observer.observe(el);
		});
	</script>
</html>

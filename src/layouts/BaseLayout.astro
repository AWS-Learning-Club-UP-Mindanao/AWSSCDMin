---
import '../styles/global.css';

interface Props {
	/** Page title. */
	title: string;
	description?: string;
	/** Social sharing image, a path under public/ or an absolute URL. */
	image?: string;
	/** Keep the page out of search results (404). */
	noindex?: boolean;
}

const {
	title,
	description = 'AWS Student Community Day Mindanao. A one-day student conference on cloud, AI, and building in community.',
	image = '/og_image.webp',
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- The header and hero button are the only text on the first screen, both Ember bold. The
		     other fonts start below the hero, so preloading them would only compete with the hero logo.
		     crossorigin is required for font preloads, even same-origin, or the file downloads twice. -->
		<link rel="preload" href="/assets/fonts/amazon-ember-display-bold.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#020110" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="AWS Student Community Day Mindanao" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content="4850" />
		<meta property="og:image:height" content="2845" />
		<meta property="og:image:alt" content="AWS Student Community Day Mindanao 2026, November 2026. Build Beyond. Dream Limitless." />
		<meta name="twitter:card" content="summary_large_image" />
		<!-- Set before first paint so reveal targets start hidden instead of flashing in. -->
		<script is:inline>document.documentElement.dataset.revealReady = '';</script>
		<!-- Images stay hidden until fully downloaded, so a slow connection never shows them painting in
		     strips. load/error don't bubble, so listen in the capture phase; this runs before any image
		     is parsed. error counts too, or a failed image would hide its alt text forever. -->
		<script is:inline>
			for (const type of ['load', 'error'])
				document.addEventListener(type, (e) => e.target.tagName === 'IMG' && e.target.setAttribute('data-loaded', ''), true);
		</script>
		<!-- Extra head tags per page. -->
		<slot name="head" />
	</head>
	<body class="bg-surface-primary font-body text-content-primary">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-surface-white focus:px-4 focus:py-2 focus:text-content-brand"
		>
			Skip to content
		</a>

		<slot name="header" />

		<main id="main" class="overflow-x-clip">
			<slot />
		</main>

		<!-- Ticket 06 puts the footer in here. -->
		<footer>
			<slot name="footer" />
		</footer>

		<script>
			// Star SVGs only animate when loaded as `file.svg#play` (svg:target in the SVG), so the
			// sequence starts each time one scrolls into view and stops when it leaves. It waits for the
			// file to finish loading so a slow connection doesn't play it half-drawn.
			const io = new IntersectionObserver(
				(entries) => {
					for (const { target, isIntersecting } of entries) {
						const img = target as HTMLImageElement;
						const base = img.src.split('#')[0];
						img.toggleAttribute('data-in-view', isIntersecting);
						if (!isIntersecting) {
							if (img.src !== base) img.src = base;
							continue;
						}
						// Still in view once loaded? Then play.
						img.decode().catch(() => {}).then(() => {
							if (img.hasAttribute('data-in-view') && img.src === base) img.src = base + '#play';
						});
					}
				},
				// Any part inside the top 80% of the viewport counts: some star images are huge and mostly
				// clipped, so a visible-ratio threshold would never fire for them.
				{ rootMargin: '0px 0px -20% 0px' },
			);
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.querySelectorAll('img[data-play-in-view]').forEach((img) => io.observe(img));
			}
		</script>
	</body>
	<script>
		const observer = new IntersectionObserver(
			(entries) => {
				// Stagger by order within each batch, not DOM position, so items revealed later
				// (expanded schedule rows, swiped ticket cards, deep links) don't wait on a long delay.
				let i = 0;
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const el = entry.target as HTMLElement;
					el.style.setProperty('--reveal-i', String(Math.min(i++, 6)));
					observer.unobserve(entry.target);
					// Hold the reveal until its images are in, so they don't fade in half-painted, but no
					// longer than 1s so a slow connection still sees the content.
					// data-reveal-wait="N" waits for only the first N (e.g. a carousel's opening slides).
					const imgs = (el.matches('img') ? [el as HTMLImageElement] : [...el.querySelectorAll('img')]).slice(
						0,
						Number(el.dataset.revealWait) || undefined,
					);
					Promise.race([
						Promise.all(imgs.map((img) => img.decode().catch(() => {}))),
						new Promise((r) => setTimeout(r, 1000)),
					]).then(() => el.setAttribute('data-revealed', ''));
				}
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);

		document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
		document.querySelectorAll('[data-reveal-stagger] > *').forEach((el) => observer.observe(el));
	</script>
</html>
